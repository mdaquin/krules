@prefix : <http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/> .

<http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              rdfs:domain :Device ;
              rdfs:range :DeviceComponent .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/inventedBy
:inventedBy rdf:type owl:ObjectProperty ;
            owl:inverseOf :inventorOf ;
            rdfs:domain :Device ;
            rdfs:range :Person .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/inventorOf
:inventorOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Person ;
            rdfs:range :Device .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/manufacturedBy
:manufacturedBy rdf:type owl:ObjectProperty ;
                owl:inverseOf :manufactures ;
                rdfs:domain :ManufacturedProduct ;
                rdfs:range :ManufacturingCompany .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/manufactures
:manufactures rdf:type owl:ObjectProperty ;
              rdfs:domain :ManufacturingCompany ;
              rdfs:range :ManufacturedProduct .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/alternativeName
:alternativeName rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf owl:topDataProperty ;
                 rdfs:domain :Device .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/inventedIn
:inventedIn rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:int .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/name
:name rdf:type owl:DatatypeProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :Device
                                  :Person
                                )
                  ] .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/patentedIn
:patentedIn rdf:type owl:DatatypeProperty ;
            rdfs:domain :Device ;
            rdfs:range xsd:int .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Car
:Car rdf:type owl:Class ;
     rdfs:subClassOf :Vehicule .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Company
:Company rdf:type owl:Class ;
         rdfs:subClassOf :Organization .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :Product .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/DeviceComponent
:DeviceComponent rdf:type owl:Class .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ElectronicComponent
:ElectronicComponent rdf:type owl:Class ;
                     rdfs:subClassOf :DeviceComponent .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ElectronicMusicalInstrument
:ElectronicMusicalInstrument rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :MusicalInstrument
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasComponent ;
                                                                          owl:someValuesFrom :ElectronicComponent
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                             rdfs:subClassOf :MusicalInstrument .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ManufacturedProduct
:ManufacturedProduct rdf:type owl:Class ;
                     rdfs:subClassOf :Product .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ManufacturerOfMotorbikes
:ManufacturerOfMotorbikes rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :Company
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :manufactures ;
                                                                       owl:someValuesFrom :Motorbike
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] ;
                          rdfs:subClassOf :ManufacturingCompany .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ManufacturerOfMusicalInstrument
:ManufacturerOfMusicalInstrument rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( :Company
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty :manufactures ;
                                                                              owl:someValuesFrom :MusicalInstrument
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf :ManufacturingCompany .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/ManufacturingCompany
:ManufacturingCompany rdf:type owl:Class ;
                      rdfs:subClassOf :Company .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Motorbike
:Motorbike rdf:type owl:Class ;
           rdfs:subClassOf :Vehicule .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/MusicalInstrument
:MusicalInstrument rdf:type owl:Class ;
                   rdfs:subClassOf :Device ,
                                   :ManufacturedProduct .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Organization
:Organization rdf:type owl:Class .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/PackagingComponent
:PackagingComponent rdf:type owl:Class ;
                    rdfs:subClassOf :DeviceComponent .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Person
:Person rdf:type owl:Class .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Product
:Product rdf:type owl:Class .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/Vehicule
:Vehicule rdf:type owl:Class ;
          rdfs:subClassOf :Product .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/LeonTheremin
:LeonTheremin rdf:type owl:NamedIndividual ,
                       :Person ;
              :name "Leon Theremin" .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/amplifier
:amplifier rdf:type owl:NamedIndividual ,
                    :ElectronicComponent .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/mogg
:mogg rdf:type owl:NamedIndividual ,
               :Company .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/theremin
:theremin rdf:type owl:NamedIndividual ,
                   :ElectronicMusicalInstrument ;
          :hasComponent :amplifier ;
          :inventedBy :LeonTheremin ;
          :manufacturedBy :mogg ;
          :alternativeName "etherphone"@en ;
          :inventedIn 1920 ;
          :name "Theremin"@en ;
          :patentedIn 1928 .


###  http://www.semanticweb.org/mdaquin/ontologies/2026/3/untitled-ontology-30/yamaha
:yamaha rdf:type owl:NamedIndividual ,
                 :ManufacturerOfMotorbikes ,
                 :ManufacturerOfMusicalInstrument .


